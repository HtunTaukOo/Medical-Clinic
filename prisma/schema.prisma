generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClinicSettings {
  id                  String   @id @default(cuid())
  isOpen              Boolean  @default(true)
  openingTime         String   @default("09:00")
  closingTime         String   @default("17:00")
  phones              String[] @default([])
  address             String?
  staffTelegramChatId String?
  updatedAt           DateTime @updatedAt
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PHARMACIST
  LAB_TECH
  PATIENT
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role
  locale              String    @default("en")
  active              Boolean   @default(true)
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  patient           Patient?
  doctorProfile     DoctorProfile?
  medicalRecords    MedicalRecord[]
  attendanceRecords AttendanceRecord[]
  purchaseOrders    PurchaseOrder[]
  announcements     Announcement[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id             String    @id @default(cuid())
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientCode    String?   @unique
  active         Boolean   @default(true)
  name           String
  gender         Gender?
  email          String?
  dob            DateTime?
  phone          String?
  address        String?
  notes          String?
  bloodType      String?
  nationality    String?
  nrcNumber      String?
  heightCm       Float?
  weightKg       Float?
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceGroupNumber  String?
  insuranceCoverageType String?
  insurancePolicyHolder String?
  insuranceExpiryDate   DateTime?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  emergencyContactAltPhone     String?
  emergencyContactAddress      String?
  notifyAppointmentReminders  Boolean @default(true)
  notifyLabResults            Boolean @default(true)
  notifyPrescriptionRenewals  Boolean @default(true)
  notifyAnnouncements         Boolean @default(false)
  notifyPromotions            Boolean @default(false)
  shareRecordsWithSpecialist  Boolean @default(true)
  allowAnalytics               Boolean @default(false)
  telegramChatId String?
  createdAt      DateTime  @default(now())

  appointments        Appointment[]
  invoices            Invoice[]
  prescriptions       Prescription[]
  medicalRecords      MedicalRecord[]
  pillReminders       PillReminder[]
  labOrders           LabOrder[]
  telegramChatMessages TelegramChatMessage[]
  waitlistEntries      Waitlist[]
  diagnoses            Diagnosis[]
  insuranceClaims      InsuranceClaim[]
  walkIns              WalkIn[]
  allergyRecords       Allergy[]
  notifications        Notification[]
}

enum AllergyCategory {
  DRUG
  FOOD
  ENVIRONMENTAL
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

model Allergy {
  id         String          @id @default(cuid())
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name       String
  category   AllergyCategory @default(OTHER)
  reaction   String?
  severity   AllergySeverity @default(MILD)
  firstNoted DateTime?
  createdAt  DateTime        @default(now())

  @@index([patientId])
}

model TelegramChatMessage {
  id             String   @id @default(cuid())
  staffMessageId Int      @unique
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model DoctorProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty        String?
  consultationFee  Decimal @default(0) @db.Decimal(10, 2)
  workingDays      Int[]   @default([1, 2, 3, 4, 5])
  workStartTime    String?
  workEndTime      String?
  experienceYears  Int?
  qualifications   String?

  notifyNewAppointments Boolean @default(true)
  notifyLabResults      Boolean @default(true)
  notifyAnnouncements   Boolean @default(true)

  appointments     Appointment[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  leaveDays        DoctorLeave[]
  waitlistEntries  Waitlist[]
  diagnoses        Diagnosis[]
  walkIns          WalkIn[]
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CANCELLED
}

model Waitlist {
  id          String         @id @default(cuid())
  patientId   String
  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  requestedAt DateTime
  reason      String?
  status      WaitlistStatus @default(WAITING)
  notifiedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([doctorId, status, requestedAt])
}

model DoctorLeave {
  id        String        @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime      @default(now())

  @@unique([doctorId, date])
  @@index([doctorId, date])
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      DoctorProfile     @relation(fields: [doctorId], references: [id])
  scheduledAt DateTime
  status      AppointmentStatus @default(REQUESTED)
  reason      String?
  notes       String?
  checkedInAt DateTime?
  reminderSent Boolean          @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  bpSystolic      Int?
  bpDiastolic     Int?
  heartRateBpm    Int?
  temperatureC    Decimal?       @db.Decimal(4, 1)
  respiratoryRate Int?
  spo2Percent     Int?

  invoice       Invoice?
  prescriptions Prescription[]
  labOrders     LabOrder[]
  diagnoses     Diagnosis[]
  walkIn        WalkIn?

  @@index([doctorId, scheduledAt])
  @@index([patientId])
}

enum WalkInStatus {
  WAITING
  CALLED
  COMPLETED
  CANCELLED
}

model WalkIn {
  id            String        @id @default(cuid())
  tokenNumber   Int
  name          String?
  phone         String?
  reason        String?
  doctorId      String?
  doctor        DoctorProfile? @relation(fields: [doctorId], references: [id])
  status        WalkInStatus  @default(WAITING)
  patientId     String?
  patient       Patient?      @relation(fields: [patientId], references: [id])
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())

  @@index([status, createdAt])
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
}

enum DiagnosisSeverity {
  MILD
  MODERATE
  SEVERE
}

model Diagnosis {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile     @relation(fields: [doctorId], references: [id])
  code          String?
  description   String
  notes         String?
  status        DiagnosisStatus   @default(ACTIVE)
  severity      DiagnosisSeverity?
  createdAt     DateTime          @default(now())

  @@index([patientId])
  @@index([appointmentId])
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

model Invoice {
  id            String        @id @default(cuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  status        InvoiceStatus @default(UNPAID)
  total         Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]
  claims   InsuranceClaim[]

  @@index([patientId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  INSURANCE
  OTHER
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CASH)
  paidAt    DateTime      @default(now())

  refunds        Refund[]
  insuranceClaim InsuranceClaim?
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model InsuranceClaim {
  id                String      @id @default(cuid())
  invoiceId         String
  invoice           Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insuranceProvider String
  policyNumber      String
  claimedAmount     Decimal     @db.Decimal(10, 2)
  approvedAmount    Decimal?    @db.Decimal(10, 2)
  status            ClaimStatus @default(SUBMITTED)
  notes             String?
  paymentId         String?     @unique
  payment           Payment?    @relation(fields: [paymentId], references: [id])
  submittedAt       DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([invoiceId])
  @@index([patientId])
  @@index([status])
}

model Refund {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  reason    String?
  createdAt DateTime @default(now())

  @@index([paymentId])
}

model Package {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String   @default("General")
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
}

enum NotificationCategory {
  APPOINTMENT
  LAB_RESULT
  PRESCRIPTION
  ANNOUNCEMENT
}

enum NotificationTone {
  INFO
  SUCCESS
  WARNING
}

model Notification {
  id        String               @id @default(cuid())
  patientId String
  patient   Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  tone      NotificationTone     @default(INFO)
  title     String
  body      String
  href      String?
  relatedId String
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@unique([patientId, relatedId])
  @@index([patientId, read])
  @@index([patientId, category])
}

model Medicine {
  id           String    @id @default(cuid())
  name         String
  unit         String
  stockQty     Int       @default(0)
  reorderLevel Int       @default(10)
  price        Decimal   @db.Decimal(10, 2)
  expiryDate   DateTime?
  featured     Boolean   @default(false)
  brand        String?
  category     String?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prescriptionItems  PrescriptionItem[]
  stockTransactions  StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicineId      String
  medicine        Medicine      @relation(fields: [medicineId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(10, 2)
  receivedQty     Int           @default(0)

  @@index([purchaseOrderId])
}

model Prescription {
  id            String        @id @default(cuid())
  appointmentId String
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id])
  fulfilled     Boolean       @default(false)
  fulfilledAt   DateTime?
  createdAt     DateTime      @default(now())

  items PrescriptionItem[]

  @@index([patientId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
  dosage         String
  quantity       Int
  timesPerDay    Int?
  durationDays   Int?
  frequency      String?
  instructions   String?
  refillsLeft    Int?

  reminders PillReminder[]
}

model PillReminder {
  id                 String           @id @default(cuid())
  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scheduledFor       DateTime
  sent               Boolean          @default(false)
  sentAt             DateTime?
  createdAt          DateTime         @default(now())

  @@index([sent, scheduledFor])
  @@index([patientId])
}

enum StockTransactionType {
  IN
  OUT
}

model StockTransaction {
  id         String               @id @default(cuid())
  medicineId String
  medicine   Medicine             @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  type       StockTransactionType
  quantity   Int
  reason     String?
  createdAt  DateTime             @default(now())

  @@index([medicineId])
}

enum MedicalRecordType {
  NOTE
  DOCUMENT
}

model MedicalRecord {
  id        String            @id @default(cuid())
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User              @relation(fields: [authorId], references: [id])
  type      MedicalRecordType
  note      String?
  fileName  String?
  fileType  String?
  fileData  Bytes?
  createdAt DateTime          @default(now())

  @@index([patientId])
}

model AttendanceRecord {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn   DateTime
  clockOut  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, clockIn])
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  actorRole String
  action    String
  target    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model LabTest {
  id          String   @id @default(cuid())
  name        String
  unit        String?
  normalRange String?
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems LabOrderItem[]
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  COMPLETED
  CANCELLED
}

model LabOrder {
  id                String         @id @default(cuid())
  patientId         String
  patient           Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            DoctorProfile  @relation(fields: [doctorId], references: [id])
  appointmentId     String?
  appointment       Appointment?   @relation(fields: [appointmentId], references: [id])
  status            LabOrderStatus @default(ORDERED)
  sampleCollectedAt DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items LabOrderItem[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

enum LabResultStatus {
  NORMAL
  BORDERLINE
  LOW
  HIGH
}

model LabOrderItem {
  id              String           @id @default(cuid())
  labOrderId      String
  labOrder        LabOrder         @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTestId       String
  labTest         LabTest          @relation(fields: [labTestId], references: [id])
  price           Decimal          @db.Decimal(10, 2)
  resultValue     String?
  resultNote      String?
  resultStatus    LabResultStatus?
  resultEnteredAt DateTime?
}
